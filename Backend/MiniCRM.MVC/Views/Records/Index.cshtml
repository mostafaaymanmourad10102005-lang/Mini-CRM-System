@model MiniCRM.MVC.Models.RecordListViewModel
@{ ViewData["Title"] = Model.Title; }
<div class="d-flex justify-content-between align-items-end mb-4"><div><h1 class="h2">@Model.Title</h1><p class="text-secondary mb-0">Manage your @Model.Title.ToLowerInvariant() using the shared CRM service.</p></div><a class="btn btn-primary" asp-action="Create" asp-route-kind="@Model.Kind">+ Add @Model.Title.TrimEnd('s').ToLowerInvariant()</a></div>
@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}@if(TempData["Error"] is string err){<div class="alert alert-warning">@err</div>}
<section class="card"><div class="card-body">@if(Model.Kind=="leads"){<form method="get" class="d-flex gap-2 mb-3"><input type="hidden" name="kind" value="@Model.Kind"/><input class="form-control search" name="search" value="@ViewBag.Search" placeholder="Search leads"/><button class="btn btn-outline-secondary">Search</button></form>}<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Record</th><th>Details</th><th>Status</th><th>Related / Value</th><th>Date</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Primary</td><td>@x.Secondary</td><td>@x.Status</td><td>@x.Related</td><td>@x.Date?.ToLocalTime().ToString("g")</td><td class="text-nowrap">@if(Model.Kind is "leads" or "opportunities" or "tasks" or "contacts"){<a asp-action="Edit" asp-route-kind="@Model.Kind" asp-route-id="@x.Id">Edit</a><form method="post" asp-action="Delete" class="d-inline ms-2">@Html.AntiForgeryToken()<input type="hidden" name="kind" value="@Model.Kind"/><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-link p-0 text-danger" onclick="return confirm('Delete this record?')">Delete</button></form>}@if(Model.Kind=="leads"){<form method="post" asp-action="ConvertLead" class="d-inline ms-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="btn btn-link p-0">Convert</button></form>}</td></tr>}</tbody></table></div>@if(Model.Items.Count==0){<p class="text-secondary py-3">No @Model.Title.ToLowerInvariant() found.</p>}<div class="d-flex justify-content-between"><small class="text-secondary">@Model.TotalCount records · page @Model.Page</small><div class="btn-group"><a class="btn btn-sm btn-outline-secondary @(Model.Page<=1?"disabled":"")" asp-route-kind="@Model.Kind" asp-route-page="@(Model.Page-1)">Previous</a><a class="btn btn-sm btn-outline-secondary @(Model.Page*Model.PageSize>=Model.TotalCount?"disabled":"")" asp-route-kind="@Model.Kind" asp-route-page="@(Model.Page+1)">Next</a></div></div></div></section>
