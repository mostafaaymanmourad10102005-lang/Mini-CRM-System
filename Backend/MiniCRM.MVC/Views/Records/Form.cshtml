@model MiniCRM.MVC.Models.RecordFormViewModel
@using MiniCRM.Domain
@{ ViewData["Title"] = $"{(Model.Id==0?"Add":"Edit")} {ViewBag.Title}"; var customers=(IReadOnlyList<Customer>)ViewBag.Customers; var leads=(IReadOnlyList<Lead>)ViewBag.Leads; var opportunities=(IReadOnlyList<Opportunity>)ViewBag.Opportunities; }
<div class="mb-4"><a asp-action="Index" asp-route-kind="@Model.Kind">← @ViewBag.Title</a><h1 class="h2 mt-2">@ViewData["Title"]</h1></div>
<section class="card"><div class="card-body"><form asp-action="Save" method="post">@Html.AntiForgeryToken()<input asp-for="Kind" type="hidden"/><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
@if(Model.Kind is "leads" or "opportunities" or "tasks"){@Field(nameof(Model.Title),"Title")}
@if(Model.Kind=="contacts"){@Field(nameof(Model.FullName),"Full name")}
@if(Model.Kind=="notes"){@Field(nameof(Model.Content),"Note",true)}
@if(Model.Kind=="activities"){@Field(nameof(Model.Description),"Description",true)<div class="mb-3"><label asp-for="ActivityType" class="form-label">Activity type</label><select asp-for="ActivityType" class="form-select"><option>Call</option><option>Email</option><option>Meeting</option><option>Note</option></select></div>}
@if(Model.Kind=="leads"){@Field(nameof(Model.ContactName),"Contact name")@Field(nameof(Model.Email),"Email")@Field(nameof(Model.PhoneNumber),"Phone")@Field(nameof(Model.Source),"Source")<div class="mb-3"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" class="form-select"><option>New</option><option>Contacted</option><option>Qualified</option><option>Lost</option></select><span asp-validation-for="Status" class="text-danger"></span></div>@Field(nameof(Model.Amount),"Estimated value")}
@if(Model.Kind=="opportunities"){@CustomerSelect()@Select(nameof(Model.LeadId),"Lead",leads.Select(x=>(x.Id,x.Title)))@Field(nameof(Model.Description),"Description",true)@Field(nameof(Model.Amount),"Amount")<div class="mb-3"><label asp-for="Stage" class="form-label">Stage</label><select asp-for="Stage" class="form-select"><option>Qualification</option><option>NeedsAnalysis</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select></div>@Field(nameof(Model.ExpectedCloseDate),"Expected close",false,"date")}
@if(Model.Kind=="tasks"){@Field(nameof(Model.Description),"Description",true)@Field(nameof(Model.DueDate),"Due date",false,"datetime-local")<div class="mb-3"><label asp-for="Priority" class="form-label">Priority</label><select asp-for="Priority" class="form-select"><option>Low</option><option>Medium</option><option>High</option><option>Urgent</option></select></div><div class="mb-3"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" class="form-select"><option>Open</option><option>InProgress</option><option>Completed</option><option>Cancelled</option></select></div>@CustomerSelect()@Select(nameof(Model.LeadId),"Lead",leads.Select(x=>(x.Id,x.Title)))@Select(nameof(Model.OpportunityId),"Opportunity",opportunities.Select(x=>(x.Id,x.Title)))}
@if(Model.Kind=="contacts"){@CustomerSelect()@Field(nameof(Model.Email),"Email")@Field(nameof(Model.PhoneNumber),"Phone")@Field(nameof(Model.Title),"Job title")<div class="form-check mb-3"><input asp-for="IsPrimary" class="form-check-input"/><label asp-for="IsPrimary" class="form-check-label">Primary contact</label></div>}
@if(Model.Kind is "notes" or "activities"){@CustomerSelect()@Select(nameof(Model.LeadId),"Lead",leads.Select(x=>(x.Id,x.Title)))@Select(nameof(Model.OpportunityId),"Opportunity",opportunities.Select(x=>(x.Id,x.Title)))}
<div class="d-flex gap-2 mt-4"><button class="btn btn-primary">Save</button><a class="btn btn-outline-secondary" asp-action="Index" asp-route-kind="@Model.Kind">Cancel</a></div></form></div></section>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
@functions {
    Microsoft.AspNetCore.Html.IHtmlContent Field(string name,string label,bool wide=false,string type="text") { var value=name switch {nameof(Model.Title)=>Model.Title,nameof(Model.Content)=>Model.Content,nameof(Model.Description)=>Model.Description,nameof(Model.Email)=>Model.Email,nameof(Model.PhoneNumber)=>Model.PhoneNumber,nameof(Model.ContactName)=>Model.ContactName,nameof(Model.Source)=>Model.Source,nameof(Model.Amount)=>Model.Amount==0?"0":Model.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture),nameof(Model.ExpectedCloseDate)=>Model.ExpectedCloseDate?.ToString("yyyy-MM-dd"),nameof(Model.DueDate)=>Model.DueDate?.ToString("yyyy-MM-ddTHH:mm"),_=>""}; var tag=wide?"textarea":"input"; var b=new System.Text.StringBuilder(); if(wide){b.Append($"<div class='mb-3'><label class='form-label' for='{name}'>{label}</label><textarea class='form-control' id='{name}' name='{name}' rows='4'>{System.Net.WebUtility.HtmlEncode(value)}</textarea><span class='text-danger field-validation-valid' data-valmsg-for='{name}'></span></div>");}else{b.Append($"<div class='mb-3'><label class='form-label' for='{name}'>{label}</label><input class='form-control' type='{type}' id='{name}' name='{name}' value='{System.Net.WebUtility.HtmlEncode(value)}'/><span class='text-danger field-validation-valid' data-valmsg-for='{name}'></span></div>");}return new Microsoft.AspNetCore.Html.HtmlString(b.ToString()); }
    Microsoft.AspNetCore.Html.IHtmlContent CustomerSelect(){var options=(IReadOnlyList<Customer>)ViewBag.Customers;return Select(nameof(Model.CustomerId),"Customer",options.Select(x=>(x.Id,$"{x.FirstName} {x.LastName}")));}
    Microsoft.AspNetCore.Html.IHtmlContent Select(string name,string label,IEnumerable<(int Id,string Name)> items){var b=new System.Text.StringBuilder($"<div class='mb-3'><label class='form-label' for='{name}'>{label}</label><select class='form-select' id='{name}' name='{name}'><option value=''>— Select —</option>");var selected=name==nameof(Model.CustomerId)?Model.CustomerId:name==nameof(Model.LeadId)?Model.LeadId:Model.OpportunityId;foreach(var item in items)b.Append($"<option value='{item.Id}' {(selected==item.Id?"selected":"")}>{System.Net.WebUtility.HtmlEncode(item.Name)}</option>");b.Append("</select></div>");return new Microsoft.AspNetCore.Html.HtmlString(b.ToString());}
}
