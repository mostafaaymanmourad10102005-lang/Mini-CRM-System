<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · MiniCRM</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body><div class="app-shell"><aside class="sidebar"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">m</span> miniCRM</a><div class="nav-label">WORKSPACE</div><a class="side-link" asp-controller="Home" asp-action="Index">◫ &nbsp; Overview</a><a class="side-link" asp-controller="Customers" asp-action="Index">♧ &nbsp; Customers</a><a class="side-link" asp-controller="Records" asp-action="Index" asp-route-kind="leads">◉ &nbsp; Leads</a><a class="side-link" asp-controller="Records" asp-action="Index" asp-route-kind="opportunities">▤ &nbsp; Opportunities</a><a class="side-link" asp-controller="Records" asp-action="Index" asp-route-kind="tasks">✓ &nbsp; Tasks</a><a class="side-link" asp-controller="Records" asp-action="Index" asp-route-kind="contacts">♙ &nbsp; Contacts</a><a class="side-link" asp-controller="Records" asp-action="Index" asp-route-kind="notes">▤ &nbsp; Notes</a><a class="side-link" asp-controller="Records" asp-action="Index" asp-route-kind="activities">◷ &nbsp; Activities</a>@if(User.IsInRole("Admin")){<a class="side-link" asp-controller="Users" asp-action="Index">⚙ &nbsp; Users</a>}<div class="profile"><div class="avatar">@((User.Identity?.Name??"U").Substring(0,1).ToUpperInvariant())</div><div><strong>@User.Identity?.Name</strong><small>@(User.IsInRole("Admin")?"Admin":User.IsInRole("Manager")?"Manager":"Sales representative")</small></div><a class="ms-auto" asp-controller="Profile" asp-action="Index">Profile</a><form asp-controller="Account" asp-action="Logout" method="post" class="ms-2"><button class="btn btn-sm btn-link">Sign out</button></form></div></aside><main class="main-content"><header class="topbar"><span>MiniCRM / <strong>@ViewData["Title"]</strong></span><span class="top-actions">@DateTime.Today.ToString("D")</span></header><div class="page-content">@RenderBody()</div></main></div><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
