@model IReadOnlyList<MiniCRM.MVC.Models.UserRowViewModel>
@{ViewData["Title"]="User management";}
<h1 class="h2">User management</h1><p class="text-secondary mb-4">Manage account roles and access.</p>
@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}@if(TempData["Error"] is string err){<div class="alert alert-warning">@err</div>}
<section class="card"><div class="card-body"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>User</th><th>Email</th><th>Role</th><th>Access</th><th>Update</th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.Name</td><td>@u.Email</td><td>@u.Role</td><td>@(u.IsActive?"Active":"Disabled")</td><td><form asp-action="Update" method="post" class="d-flex gap-2 align-items-center"><input type="hidden" name="Id" value="@u.Id"/><select class="form-select form-select-sm" name="Role"><option value="Admin" selected="@(u.Role=="Admin"?"selected":null)">Admin</option><option value="Manager" selected="@(u.Role=="Manager"?"selected":null)">Manager</option><option value="SalesRepresentative" selected="@(u.Role=="SalesRepresentative"?"selected":null)">SalesRepresentative</option></select><label class="form-check mb-0 text-nowrap"><input class="form-check-input" type="checkbox" name="IsActive" value="true" checked="@(u.IsActive?"checked":null)"/> Active</label><input type="hidden" name="IsActive" value="false"/><button class="btn btn-sm btn-outline-primary">Save</button></form></td></tr>}</tbody></table></div></div></section>
