@using MiniCRM.Application
@using MiniCRM.Domain
@{ ViewData["Title"] = "Overview"; var s = (DashboardSummary)ViewBag.Summary; var customers=(IReadOnlyList<Customer>)ViewBag.RecentCustomers; var tasks=(IReadOnlyList<CrmTask>)ViewBag.TodayTasks; }
<div class="d-flex justify-content-between align-items-end mb-4"><div><p class="text-primary fw-semibold mb-1">@DateTime.Today.ToString("dddd, MMMM d")</p><h1 class="h2 mb-1">Good @((DateTime.Now.Hour < 12) ? "morning" : DateTime.Now.Hour < 18 ? "afternoon" : "evening"), @User.Identity?.Name</h1><p class="text-secondary mb-0">Here’s what’s happening across your relationships.</p></div><a class="btn btn-primary" asp-controller="Customers" asp-action="Create">+ Add customer</a></div>
<div class="row g-3 mb-4">
@foreach (var card in new[]{("Customers",(object)s.Customers,"Across your accounts"),("Open leads",(object)(s.Leads-s.ConvertedLeads),"Active conversations"),("Pipeline",(object)s.PipelineValue.ToString("C0"),"Open opportunities"),("Pending tasks",(object)s.PendingTasks,"Needs your attention")}) { <div class="col-6 col-xl-3"><div class="card metric h-100"><div class="card-body"><span class="text-secondary small">@card.Item1</span><div class="display-6 fs-2 fw-semibold my-2">@card.Item2</div><span class="text-secondary small">@card.Item3</span></div></div></div> }
</div>
<div class="row g-4"><div class="col-lg-8"><section class="card"><div class="card-body"><div class="d-flex justify-content-between mb-3"><h2 class="h5">Recent customers</h2><a asp-controller="Customers" asp-action="Index">View all</a></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Company</th><th>Location</th><th>Status</th></tr></thead><tbody>@if(customers.Count==0){<tr><td colspan="4" class="text-secondary">No customers yet. Add your first customer.</td></tr>}@foreach(var c in customers){<tr><td><a asp-controller="Customers" asp-action="Details" asp-route-id="@c.Id">@c.FirstName @c.LastName</a></td><td>@(c.CompanyName??"—")</td><td>@(string.Join(", ",new[]{c.City,c.Country}.Where(x=>!string.IsNullOrWhiteSpace(x))))</td><td>@c.Status</td></tr>}</tbody></table></div></div></section></div><div class="col-lg-4"><section class="card"><div class="card-body"><h2 class="h5 mb-3">Your tasks</h2>@if(tasks.Count==0){<p class="text-secondary">No tasks found.</p>}@foreach(var t in tasks){<div class="border-start border-3 border-primary ps-3 mb-3"><strong>@t.Title</strong><div class="small text-secondary">@(t.DueDate?.ToLocalTime().ToString("MMM d, h:mm tt")??"No due date") · @t.Priority</div></div>}<hr><div class="d-flex justify-content-between"><span class="text-secondary">Won revenue</span><strong>@s.WonRevenue.ToString("C0")</strong></div></div></section></div></div>
