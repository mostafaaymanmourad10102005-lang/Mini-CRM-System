@model Page<Customer>
@{ ViewData["Title"] = "Customers"; }
<div class="d-flex justify-content-between align-items-end mb-4"><div><h1 class="h2">Customers</h1><p class="text-secondary mb-0">Keep every customer relationship organized.</p></div><a asp-action="Create" class="btn btn-primary">+ Add customer</a></div>
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}
<section class="card"><div class="card-body"><form method="get" class="d-flex gap-2 mb-3"><input class="form-control search" name="search" value="@ViewBag.Search" placeholder="Search customers"/><button class="btn btn-outline-secondary">Search</button></form><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Company</th><th>Email</th><th>City</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var c in Model.Items){<tr><td><a asp-action="Details" asp-route-id="@c.Id" class="fw-semibold">@c.FirstName @c.LastName</a></td><td>@c.CompanyName</td><td>@c.Email</td><td>@c.City</td><td><span class="badge text-bg-light">@c.Status</span></td><td><a asp-action="Edit" asp-route-id="@c.Id">Edit</a></td></tr>}</tbody></table></div>@if(Model.TotalCount==0){<p class="text-secondary py-3">No customers found.</p>}<div class="d-flex justify-content-between align-items-center"><small class="text-secondary">@Model.TotalCount customers · page @Model.PageNumber</small><div class="btn-group"><a class="btn btn-sm btn-outline-secondary @(Model.PageNumber<=1?"disabled":"")" asp-route-page="@(Model.PageNumber-1)" asp-route-search="@ViewBag.Search">Previous</a><a class="btn btn-sm btn-outline-secondary @(Model.PageNumber*Model.PageSize>=Model.TotalCount?"disabled":"")" asp-route-page="@(Model.PageNumber+1)" asp-route-search="@ViewBag.Search">Next</a></div></div></div></section>
