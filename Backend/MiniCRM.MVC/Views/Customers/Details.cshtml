@model Customer
@{ ViewData["Title"] = Model.FirstName+" "+Model.LastName; }
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-warning">@error</div>}
<div class="d-flex justify-content-between align-items-start mb-4"><div><a asp-action="Index" class="small">← Customers</a><h1 class="h2 mt-2">@Model.FirstName @Model.LastName</h1><p class="text-secondary">@Model.JobTitle · @Model.CompanyName</p></div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit customer</a></div>
<div class="row g-4"><div class="col-lg-7"><section class="card"><div class="card-body"><h2 class="h5 mb-3">Customer information</h2><dl class="row mb-0"><dt class="col-sm-4">Email</dt><dd class="col-sm-8"><a href="mailto:@Model.Email">@Model.Email</a></dd><dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@Model.PhoneNumber</dd><dt class="col-sm-4">Address</dt><dd class="col-sm-8">@Model.Address<br/>@Model.City @Model.Country</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.Status</dd><dt class="col-sm-4">Source</dt><dd class="col-sm-8">@Model.Source</dd></dl></div></section></div><div class="col-lg-5"><section class="card"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">Contacts</h2><a asp-controller="Contacts" asp-action="Create" asp-route-customerId="@Model.Id">Add contact</a></div>@if(Model.Contacts.Count==0){<p class="text-secondary">No contacts have been added.</p>}@foreach(var contact in Model.Contacts){<div class="border-top pt-3 mt-3"><strong>@contact.FullName</strong>@if(contact.IsPrimary){<span class="badge text-bg-primary ms-2">Primary</span>}<div class="small text-secondary">@contact.Email · @contact.PhoneNumber</div></div>}</div></section><section class="card mt-3"><div class="card-body"><h2 class="h5">Account timeline</h2><p class="text-secondary small mb-0">Created @Model.CreatedAt.ToString("MMM d, yyyy")</p>@if(Model.UpdatedAt is not null){<p class="text-secondary small">Updated @Model.UpdatedAt.Value.ToString("MMM d, yyyy")</p>}<a asp-controller="Activities" asp-action="Index" asp-route-customerId="@Model.Id">View activity history</a></div></section></div></div><form asp-action="Delete" method="post" class="mt-4" onsubmit="return confirm('Delete this customer?')"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-link text-danger px-0">Delete customer</button></form>
